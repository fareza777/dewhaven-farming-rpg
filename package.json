{
  "name": "dewhaven",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5176",
    "build": "tsc --noEmit && vite build && node tools/build-service-worker.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4176",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "assets": "python tools/prepare_assets.py",
    "android:sync": "npm run build && cap sync android && python tools/android-assets.py",
    "android:build": "powershell -NoProfile -File tools/build-android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/fraunces": "^5.2.0",
    "@fontsource/nunito": "^5.2.0",
    "@phosphor-icons/web": "^2.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@playwright/test": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  }
}
